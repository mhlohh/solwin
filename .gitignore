# ==============================================================================
# Solwin Repository .gitignore
# Covers Python (Backend, ML Services, Data), Node.js (Frontend), and OS files
# ==============================================================================

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
# Never commit credentials, private keys, access tokens, API keys
.env
.env.*
!.env.example
!.env.*.example

# --- Python Testing, Coverage & Linters ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# --- Node.js & Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json.bak

# Frontend build outputs and cache
app/frontend/dist/
app/frontend/dist-ssr/
*.tsbuildinfo
.eslintcache

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*~
.project
.pydevproject
.settings/


# --- Temporary Test Artifacts ---
sample_*
downloaded_*
bad_file.txt
scratch/
tmp/
temp/
*.log
