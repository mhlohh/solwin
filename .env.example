# Solwin stack — copy to .env and fill in real values.
# docker compose reads this file automatically; never commit the filled copy.

# --- Postgres (local compose stack) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=solwin

# --- Gemini AI (Backend) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
