# Solwin stack — copy to .env and fill in real values.
# docker compose reads this file automatically; never commit the filled copy.

# --- Postgres (local compose stack) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=solwin

# --- Gemini AI (Backend + ML service) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ML service tuning (app/ml_services) ---
MODEL_DIR=/app/models
MODEL_REGISTRY_PATH=/app/config/model_registry.yaml
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=10000
MAX_CONVERSATION_MESSAGES=100
MODEL_CONFIDENCE_THRESHOLD=0.60
REQUEST_TIMEOUT_SECONDS=15
EXTERNAL_REPUTATION_TIMEOUT_SECONDS=3

# --- Optional external provider interfaces (not required; unused by default) ---
LLM_PROVIDER=
LLM_API_KEY=
URL_REPUTATION_API_KEY=
EMAIL_REPUTATION_API_KEY=
