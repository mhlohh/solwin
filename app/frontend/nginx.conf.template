# Solwin frontend — SPA fallback + API reverse proxying.
# Upstream hosts are injected at container start via env vars:
#   BACKEND_SERVICE_URL  (default http://backend:8001)   -> proxies /api/
#   DATA_SERVICE_URL     (default http://data-api:8000)  -> proxies /data-api/
# The browser only ever talks to this one origin.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Long-cache immutable hashed assets
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Backend API (FastAPI)
    location /api/ {
        proxy_pass ${BACKEND_SERVICE_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Data API (raw feedback inbox). Bare "/" strips the /data-api/ prefix:
    #   /data-api/tickets/facets -> $DATA_SERVICE_URL/tickets/facets
    location /data-api/ {
        proxy_pass ${DATA_SERVICE_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Container health endpoint (no dependency on upstreams)
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
