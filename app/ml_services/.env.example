MODEL_DIR=models
MODEL_REGISTRY_PATH=config/model_registry.yaml
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=10000
MAX_CONVERSATION_MESSAGES=100
MODEL_CONFIDENCE_THRESHOLD=0.60
REQUEST_TIMEOUT_SECONDS=15
EXTERNAL_REPUTATION_TIMEOUT_SECONDS=3

# Gemini AI Provider
# Set GEMINI_API_KEY before starting. Never commit this file with a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENABLED=true
GEMINI_LIVE_TEST=false
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_USE_FOR_CLASSIFICATION=true
GEMINI_USE_FOR_SENTIMENT=true
GEMINI_USE_FOR_SUMMARY=true
GEMINI_USE_FOR_SOCIAL_ENGINEERING=true
GEMINI_USE_FOR_EMBEDDINGS=false

# Demo Mode: prefer cached/persisted results, avoid repeated API calls
DEMO_MODE=false
