# Application
APP_NAME="Solwin API"
APP_ENV="development"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solwin_db"

# Security & Secrets
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
ATTACHMENTS_STORAGE_DIR="storage/attachments"

